# Copy to backend/.env  (never commit the real file). All values below are placeholders.
APP_ENV=development              # development | production   (production refuses console OTP and missing secrets)
DATABASE_URL=                    # empty = SQLite file backend/data/swasthya.db. PostgreSQL: postgresql+psycopg://USER:PASSWORD@HOST:5432/swasthya
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false              # MUST be true when served over HTTPS (production)

# ---- Secrets: REQUIRED in production. In development they are auto-generated into backend/data/.dev_secrets.json
JWT_SECRET=                      # python -c "import secrets;print(secrets.token_urlsafe(48))"
DATA_ENCRYPTION_KEY=             # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  (losing it makes stored health data unreadable – back it up)

# ---- Gemini (optional; without it chat is retrieval-only and prescriptions use local OCR + rule parser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- OCR
OCR_LANGUAGES=eng                # e.g. eng+hin+kan+tel  (each language pack must be installed with Tesseract)

# ---- Login codes (MFA). 'console' prints the code in the server window: DEVELOPMENT ONLY, rejected when APP_ENV=production
OTP_EMAIL_PROVIDER=console       # smtp  <- required in production
OTP_SMS_PROVIDER=console         # twilio <- optional; if not configured SMS is simply unavailable in production
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS=4
SESSION_IDLE_MINUTES=60

SMTP_HOST=                       # e.g. smtp.gmail.com (use an app password) / your provider's host
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Swasthya Mitra <no-reply@yourdomain.example>
SMTP_STARTTLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                     # your Twilio number or messaging service sender, E.164

# ---- Biometric (WebAuthn). Must match the address users type in the browser (https required except on localhost)
WEBAUTHN_RP_ID=localhost         # production: your domain, e.g. app.example.org
WEBAUTHN_RP_NAME=Swasthya Mitra
WEBAUTHN_ORIGIN=http://localhost:3000   # production: https://app.example.org
